<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Water Buddy" Width="400" Height="544" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        UseLayoutRounding="True" FontFamily="Segoe UI" WindowStartupLocation="Manual">
  <Window.Resources>
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="20" Padding="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.86"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value="0.68"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value="0.55"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#7196D5"/><Setter TargetName="Shell" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Canvas x:Name="Scene" Width="400" Height="544">
    <Border x:Name="Bubble" Canvas.Left="30" Canvas.Top="14" Width="340" Height="108" CornerRadius="25" Background="#FFFEFC">
      <Border.Effect><DropShadowEffect Color="#243D45" Opacity="0.18" BlurRadius="22" ShadowDepth="5"/></Border.Effect>
      <StackPanel Margin="22,14,22,10">
        <TextBlock x:Name="HeaderKicker" Text="YOUR LITTLE WATER BUDDY" FontSize="9" FontWeight="SemiBold" Foreground="#6D8D89" Margin="0,0,0,5"/>
        <TextBlock x:Name="BuddyTitle" Text="Ready for a sip?" FontFamily="Segoe UI Semibold" FontSize="21" Foreground="#173E3D"/>
        <TextBlock x:Name="BuddyText" FontSize="12" Foreground="#647C78" TextWrapping="Wrap" Margin="0,5,0,0"/>
      </StackPanel>
    </Border>
    <Path x:Name="BubbleTail" Data="M 0 0 L 24 0 L 9 16 Z" Fill="#FFFEFC" Canvas.Left="180" Canvas.Top="120"/>
    <Button x:Name="BuddyClose" Style="{StaticResource Pill}" Canvas.Left="337" Canvas.Top="20" Width="26" Height="26" Background="Transparent" ToolTip="Dismiss reminder" AutomationProperties.Name="Dismiss reminder">
      <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="#7C9691" StrokeThickness="1.5" Width="8" Height="8"/>
    </Button>
    <Ellipse Canvas.Left="104" Canvas.Top="361" Width="192" Height="20" Fill="#24213F39">
      <Ellipse.Effect><BlurEffect Radius="8"/></Ellipse.Effect>
    </Ellipse>
    <Canvas x:Name="Walker" Canvas.Left="58" Canvas.Top="127" Width="284" Height="256" Cursor="SizeAll" ToolTip="Drag me anywhere">
      <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="WalkFlip" ScaleX="1" CenterX="142"/><RotateTransform x:Name="WalkTilt" CenterX="142" CenterY="160"/><TranslateTransform x:Name="Bob"/></TransformGroup></Canvas.RenderTransform>
      <Image x:Name="Picture" Width="284" Height="256" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
    </Canvas>
    <Border x:Name="AmountCard" Canvas.Left="32" Canvas.Top="281" Padding="13,9" CornerRadius="17" Background="#FFF7DE" BorderBrush="#FFFDF4" BorderThickness="2">
      <Border.Effect><DropShadowEffect Color="#315951" Opacity="0.12" BlurRadius="12" ShadowDepth="3"/></Border.Effect>
      <StackPanel><TextBlock x:Name="AmountBadge" Text="150 ml" FontSize="18" FontWeight="Bold" Foreground="#675427"/><TextBlock Text="one little sip break" FontSize="9" Foreground="#8F7C4B"/></StackPanel>
    </Border>
    <Border x:Name="ActionCard" Canvas.Left="16" Canvas.Top="378" Width="368" Height="148" CornerRadius="27" Background="#FFFEFC">
      <Border.Effect><DropShadowEffect Color="#203B36" Opacity="0.2" BlurRadius="24" ShadowDepth="6"/></Border.Effect>
      <Canvas>
        <Ellipse Canvas.Left="20" Canvas.Top="19" Width="7" Height="7" Fill="#38B99F"/>
        <TextBlock Text="Today's water" Canvas.Left="35" Canvas.Top="13" FontSize="12" FontFamily="Segoe UI Semibold" Foreground="#355852"/>
        <TextBlock x:Name="BuddyProgress" Canvas.Right="20" Canvas.Top="14" FontSize="11" Foreground="#79908A"/>
        <Border Canvas.Left="20" Canvas.Top="33" Width="328" Height="4" Background="#E8F1F3" CornerRadius="2"><Border x:Name="BuddyFill" Width="0" HorizontalAlignment="Left" Background="#34A6B5" CornerRadius="2"/></Border>
        <Button x:Name="BuddyDrink" Style="{StaticResource Pill}" Canvas.Left="14" Canvas.Top="43" Width="169" Height="62" Foreground="White" AutomationProperties.Name="I drank water - log water">
          <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#22A58A" Offset="0"/><GradientStop Color="#117F72" Offset="1"/></LinearGradientBrush></Button.Background>
          <StackPanel Orientation="Horizontal">
            <Border Width="27" Height="27" CornerRadius="14" Background="#30FFFFFF" Margin="0,0,9,0"><TextBlock Text="&#x2713;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel><TextBlock Text="I drank water" FontSize="15" FontFamily="Segoe UI Semibold"/><TextBlock x:Name="DrinkAmount" Text="Save 150 ml" FontSize="10" Opacity="0.8"/></StackPanel>
          </StackPanel>
        </Button>
        <Button x:Name="BuddyLater" Style="{StaticResource Pill}" Canvas.Left="191" Canvas.Top="43" Width="163" Height="62" Background="#EFF0FC" Foreground="#575A89" AutomationProperties.Name="Choose snooze duration">
          <StackPanel><TextBlock Text="Remind me later" FontSize="13" FontFamily="Segoe UI Semibold"/><TextBlock Text="5 / 10 / 15 minutes" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0" Foreground="#888BAA"/></StackPanel>
        </Button>
        <Button x:Name="TryReactions" Style="{StaticResource Pill}" Canvas.Left="14" Canvas.Top="108" Height="32" Width="112" Background="Transparent" Foreground="#748B84" FontSize="10" Content="Try reactions"/>
        <Button x:Name="BuddySettings" Style="{StaticResource Pill}" Canvas.Right="14" Canvas.Top="108" Height="32" Width="70" Background="Transparent" Foreground="#748B84" FontSize="10" Content="Settings"/>
      </Canvas>
    </Border>
    <Canvas x:Name="Sparkles" IsHitTestVisible="False" Opacity="0" Canvas.Left="0" Canvas.Top="140" Width="400" Height="200">
      <Canvas.RenderTransform><TranslateTransform x:Name="SparkleLift"/></Canvas.RenderTransform>
      <TextBlock Text="&#x2726;" Canvas.Left="82" Canvas.Top="100" FontSize="34" Foreground="#FFD873"/>
      <TextBlock Text="&#x2665;" Canvas.Left="300" Canvas.Top="50" FontSize="28" Foreground="#F59CAA"/>
      <TextBlock Text="&#x2726;" Canvas.Left="252" Canvas.Top="5" FontSize="22" Foreground="#78D4BE"/>
      <TextBlock Text="&#x2726;" Canvas.Left="115" Canvas.Top="15" FontSize="19" Foreground="#B6B5F0"/>
    </Canvas>
    <Popup x:Name="SnoozePopup" Placement="Top" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
      <Border Margin="12" Padding="16" CornerRadius="22" Background="#FFFEFC" BorderThickness="1" BorderBrush="#E9EAF6">
        <Border.Effect><DropShadowEffect Color="#243D45" Opacity="0.2" BlurRadius="16" ShadowDepth="4"/></Border.Effect>
        <StackPanel>
          <TextBlock Text="When should I come back?" FontSize="14" FontFamily="Segoe UI Semibold" Foreground="#424969" Margin="2,0,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="Snooze5" Style="{StaticResource Pill}" Width="72" Height="42" Content="5 min" Background="#F0F1FC" Foreground="#575A89" Margin="0,0,6,0"/>
            <Button x:Name="Snooze10" Style="{StaticResource Pill}" Width="72" Height="42" Content="10 min" Background="#DDEFE9" Foreground="#177B68" Margin="0,0,6,0"/>
            <Button x:Name="Snooze15" Style="{StaticResource Pill}" Width="72" Height="42" Content="15 min" Background="#F0F1FC" Foreground="#575A89"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
    <Popup x:Name="ReactionPopup" Placement="Top" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
      <Border Margin="12" Padding="16" CornerRadius="22" Background="#FFFEFC" BorderThickness="1" BorderBrush="#E9EAF6">
        <Border.Effect><DropShadowEffect Color="#243D45" Opacity="0.2" BlurRadius="16" ShadowDepth="4"/></Border.Effect>
        <StackPanel>
          <TextBlock Text="Meet all my moods" FontSize="14" FontFamily="Segoe UI Semibold" Foreground="#424969"/>
          <TextBlock Text="Preview only - no water logged" FontSize="10" Foreground="#7C8B87" Margin="0,4,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="PreviewWalk" Style="{StaticResource Pill}" Width="76" Height="42" Content="Walk" Background="#DDEFE9" Foreground="#177B68" Margin="0,0,6,0"/>
            <Button x:Name="PreviewHappy" Style="{StaticResource Pill}" Width="76" Height="42" Content="Happy" Background="#FFF0CD" Foreground="#8A6B2B" Margin="0,0,6,0"/>
            <Button x:Name="PreviewSad" Style="{StaticResource Pill}" Width="76" Height="42" Content="Sad" Background="#F0F1FC" Foreground="#575A89"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Canvas>
</Window>
